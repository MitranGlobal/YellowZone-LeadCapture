# ---------------------------------------------------------------------------
# Copy to .env.local for local dev, and add the same keys in Vercel →
# Project → Settings → Environment Variables for production AND preview.
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time, so add it before deploying or redeploy afterwards.
# ---------------------------------------------------------------------------

# Canonical site URL (used for OG tags, sitemap, robots).
# A bare domain is fine — lib/config.ts adds the scheme.
NEXT_PUBLIC_SITE_URL=https://schools.mitranglobal.com

# --- Video -----------------------------------------------------------------
# Served straight from Cloudinary and played by components/VideoPlayer.tsx.
# Both are optional: the component has these exact values as its defaults.
# Adding q_auto,f_auto to the path serves a compressed, format-appropriate
# version and cuts bandwidth considerably.
NEXT_PUBLIC_VIDEO_SRC=https://res.cloudinary.com/twteccae/video/upload/Yellow_Zone_V2_kvfb8m.mp4
NEXT_PUBLIC_VIDEO_POSTER=https://res.cloudinary.com/twteccae/video/upload/Yellow_Zone_V2_kvfb8m.jpg

# --- Application form (Tally) ----------------------------------------------
# Carries both the application questions and the appointment slot, so it is
# the only conversion point in the funnel.
# Turn on Tally → Settings → Notifications so submissions reach your inbox.
NEXT_PUBLIC_TALLY_SRC=https://tally.so/embed/WOadLk?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1

# --- Tracking --------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
