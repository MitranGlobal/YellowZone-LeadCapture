# ---------------------------------------------------------------------------
# Copy to .env.local for local dev, and add the same keys in Vercel →
# Project → Settings → Environment Variables for production.
# Anything prefixed NEXT_PUBLIC_ is visible in the browser. Never put a
# secret behind that prefix.
# ---------------------------------------------------------------------------

# Canonical site URL (used for OG tags, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://schools.mitranglobal.com

# --- Lead capture ----------------------------------------------------------
# Optional fallback used only when RESEND_API_KEY is not set.
# GoHighLevel / Zapier / Make / n8n all give you a URL like this.
# With neither set, submissions are logged to the server console.
LEAD_WEBHOOK_URL=

# --- Video -----------------------------------------------------------------
# The media HASHED ID (about 10 characters), not the /s/ share-link slug.
# In Wistia: open the video, click Embed & Share, and copy the id out of the
# embed code — it is the `media-id` value. A full /medias/<id> or
# /embed/iframe/<id> URL is also accepted and will be parsed down to the id.
NEXT_PUBLIC_WISTIA_MEDIA_ID=

# Fallback link shown until the id above is set.
NEXT_PUBLIC_WISTIA_SHARE_URL=https://counselmitranglobal.wistia.com/s/b2ag5xkznld3bqt

# --- Scheduling (Calendly) ------------------------------------------------
# Your Calendly event URL. Extra query params are preserved.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/counselmitranglobal/yellow-zone-schools?hide_event_type_details=1&hide_gdpr_banner=1

# --- Email notifications ---------------------------------------------------
# Resend API key (https://resend.com — free tier is plenty here).
RESEND_API_KEY=
# Where enquiry and booking emails are delivered. Comma-separate for several.
NOTIFY_EMAIL=counselmitranglobal@gmail.com
# Verified sender. Keep the resend.dev default until your domain is verified.
NOTIFY_FROM=Yellow Zone <onboarding@resend.dev>

# --- Tracking --------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
