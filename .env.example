# ---------------------------------------------------------------------------
# Copy to .env.local for local dev, and add the same keys in Vercel →
# Project → Settings → Environment Variables for production.
# Anything prefixed NEXT_PUBLIC_ is visible in the browser. Never put a
# secret behind that prefix.
# ---------------------------------------------------------------------------

# Canonical site URL (used for OG tags, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://schools.mitranglobal.com

# --- Lead capture ----------------------------------------------------------
# Inbound webhook that receives every form submission.
# GoHighLevel / Zapier / Make / n8n all give you a URL like this.
# Leave blank and leads are logged to the server console instead.
LEAD_WEBHOOK_URL=

# --- Video -----------------------------------------------------------------
# Wistia media id shown on /briefing
NEXT_PUBLIC_WISTIA_MEDIA_ID=kudy2kfy6c

# --- Payments (Razorpay) ---------------------------------------------------
# Public key id — safe in the browser
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-side credentials — never expose these
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: webhook notified after a verified payment
BOOKING_WEBHOOK_URL=

# Fallback used when no Razorpay key is set: a hosted payment link
# (Razorpay Payment Page, Stripe link, etc). Keeps the funnel alive.
NEXT_PUBLIC_PAYMENT_LINK=

# --- Tracking --------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
